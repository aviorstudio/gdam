# Point the CLI at a different registry, e.g. a local API during development.
# Defaults to https://api.gdam.dev.
GDAM_API_URL=http://127.0.0.1:8080

# Required by `gdam publish`. Create one from your owner settings page.
GDAM_SECRET_KEY=

# Optional. Raises the GitHub API rate limit while downloading release assets.
GITHUB_TOKEN=
